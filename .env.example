# ==============================================================================
# MediAssist AI — Backend Configuration Template
# 
# INSTRUCTIONS FOR BEGINNERS:
# 1. Make a copy of this file and name it exactly: .env
# 2. Open .env in your editor.
# 3. Add your preferred AI API key below (NVIDIA, Google Gemini, or OpenAI).
# 4. Save the file.
# 5. Never share your .env file or push it to GitHub!
# ==============================================================================

# Port the backend server will listen on
PORT=3000

# ------------------------------------------------------------------------------
# OPTION 1: NVIDIA NIM API (Free credits available at https://build.nvidia.com)
# ------------------------------------------------------------------------------
# NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
# Popular models: meta/llama-3.3-70b-instruct, meta/llama-3.1-70b-instruct, meta/llama-3.1-8b-instruct
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# OPTION 2: Google Gemini API (Free tier available at https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Supported models: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# OPTION 3: OpenAI API (https://platform.openai.com)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
